/*
** mmc.rc - Windows resources: the program icon and version details.
** The icon is mmc.ico. Keep the version the same as MMC_VERSION in mmc.h.
*/

1 ICON "mmc.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Marjon Mangindo Cajocon"
      VALUE "FileDescription", "MMC shell"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "mmc"
      VALUE "OriginalFilename", "mmc-shell.exe"
      VALUE "ProductName", "MMC shell"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
