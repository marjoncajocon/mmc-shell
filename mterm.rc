/*
** mterm.rc - Windows resources of mmc-term: the icon and version details.
** Icon source: logo/10-diamond-m-monogram.svg
*/

1 ICON "mmc.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Marjon Mangindo Cajocon"
      VALUE "FileDescription", "MMC terminal"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "mmc-term"
      VALUE "OriginalFilename", "mmc-term.exe"
      VALUE "ProductName", "MMC shell"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
